// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password_hash String
  rol_id        Int
  agencia_id    Int?
  
  rol           Rol      @relation(fields: [rol_id], references: [id])
  agencia       Agencia? @relation(fields: [agencia_id], references: [id])
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  usuarios    Usuario[]
  permisos    Permiso[] @relation("RolPermiso")
}

model Permiso {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  roles       Rol[]    @relation("RolPermiso")
}

model Agencia {
  id        Int       @id @default(autoincrement())
  nombre    String
  contacto  String
  telefono  String
  direccion String?
  latitud   Float?   // Para el mapa (Leaflet)
  longitud  Float?   // Para el mapa (Leaflet)
  usuarios  Usuario[]
  pedidos   Pedido[]
}

model TipoCarroceria {
  id          Int                @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio_base Decimal            @db.Decimal(10, 2)
  pedidos     Pedido[]
  recetas     RecetaCarroceria[]
}

model Material {
  id           Int                @id @default(autoincrement())
  nombre       String
  unidadMedida String
  stockActual  Float              @default(0)
  stockMinimo  Float              @default(0)
  recetas      RecetaCarroceria[]
}

model RecetaCarroceria {
  id                Int            @id @default(autoincrement())
  tipoCarroceriaId  Int
  materialId        Int
  cantidadNecesaria Float
  tipoCarroceria    TipoCarroceria @relation(fields: [tipoCarroceriaId], references: [id], onDelete: Cascade)
  material          Material       @relation(fields: [materialId], references: [id])
}

model Pedido {
  id                 Int             @id @default(autoincrement())
  agencia_id         Int
  tipo_carroceria_id Int?
  estado             String          @default("PENDIENTE") // PENDIENTE, EN_PROCESO, TERMINADO, ENTREGADO
  fecha_creacion     DateTime        @default(now())
  fecha_entrega      DateTime?
  fecha_entrega_est  DateTime?
  notas_taller       String?
  tipo_vehiculo      String?
  cantidad           Int             @default(1)
  importe            Decimal?        @db.Decimal(10, 2)
  ancho              Float?
  largo              Float?

  agencia            Agencia         @relation(fields: [agencia_id], references: [id])
  tipo_carroceria    TipoCarroceria? @relation(fields: [tipo_carroceria_id], references: [id])
}
